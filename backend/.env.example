# Database
DATABASE_URL=postgresql+asyncpg://reverse_user:reverse_pass@localhost:5432/reverse_engineering_db
SYNC_DATABASE_URL=postgresql://reverse_user:reverse_pass@localhost:5432/reverse_engineering_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Configuration — set at least one provider
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_google_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# LLM Model selection (default routing)
PRIMARY_LLM_PROVIDER=openai
PRIMARY_LLM_MODEL=gpt-4o-mini
STRONG_LLM_MODEL=gpt-4o
FAST_LLM_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_PROVIDER=local

# Upload settings
MAX_UPLOAD_SIZE_MB=100
MAX_FILES_IN_ARCHIVE=5000
MAX_SINGLE_FILE_SIZE_MB=10

# Security
SECRET_KEY=changeme-use-a-real-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Analysis
WORKSPACE_DIR=./workspaces
SANDBOX_TIMEOUT_SECONDS=30
ENABLE_SANDBOX_EXECUTION=false

# App
APP_ENV=development
LOG_LEVEL=INFO
